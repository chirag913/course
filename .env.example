# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — from Dashboard > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > (your webhook) > Secret
RAZORPAY_WEBHOOK_SECRET=

# Public site URL, used for redirects and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business/legal details shown on /about, /contact, /terms, /privacy,
# /refund-policy and the footer. Required before Razorpay submission —
# see SETUP.md. Leave unset locally; pages show a bracketed placeholder
# instead of inventing a value.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_REFUND_WINDOW_DAYS=
